# =====================================================================
# Server
# =====================================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# =====================================================================
# Database (MySQL)
# =====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cybersecurity_platform

# =====================================================================
# Auth
# =====================================================================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Credentials used ONLY by the seed script (npm run seed) to create the
# default admin + demo user accounts. Change these before running seed
# in anything resembling a production environment.
SEED_ADMIN_EMAIL=admin@cybershield.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin123!
SEED_DEMO_USER_EMAIL=demo@cybershield.local
SEED_DEMO_USER_PASSWORD=ChangeMe_Demo123!

# =====================================================================
# AI Analysis (optional — app runs in fallback/demo mode without these)
# =====================================================================
# Any Anthropic-compatible key. If unset, aiService.js automatically
# uses the built-in rule-based fallback engine instead.
AI_API_KEY=
AI_API_BASE_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6

# =====================================================================
# Threat Intelligence (optional, used by URL scanner if configured)
# =====================================================================
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# =====================================================================
# Uploads
# =====================================================================
MAX_UPLOAD_MB=5
